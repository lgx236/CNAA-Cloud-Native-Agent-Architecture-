# CNAA Configuration Examples
# Copy this file to .env and customize your settings

# ============================================================================
# Server Configuration
# ============================================================================

# Network binding
CNAA_HOST=localhost          # Change to 0.0.0.0 for all interfaces
CNAA_PORT=8080               # HTTP port

# ============================================================================
# Authentication (Optional)
# ============================================================================

# Disable authentication (default for development)
# Set to true to enable API key authentication
CNAA_AUTH_ENABLED=false

# When auth is enabled:
# CNAA_API_KEY=your-secure-random-api-key-here
# CNAA_ALLOWED_AGENTS=agent-001,agent-002,agent-003

# Allow unauthenticated requests when auth is enabled
CNAA_ALLOW_UNAUTHENTICATED=true

# ============================================================================
# Storage Backend
# ============================================================================

# Choose storage backend: in_memory, sqlite, postgresql
# Default: in_memory (development only)
CLOUD_STORAGE_BACKEND=sqlite

# SQLite configuration
SQLITE_DB_PATH=./data/cnaa.db

# PostgreSQL configuration (if backend=postgresql)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=cnaa
# POSTGRES_USER=cnaa_user
# POSTGRES_PASSWORD=your-password
# POSTGRES_SSL_MODE=require

# ChromaDB configuration (for vector/RAG)
# CHROMA_DB_PATH=./data/chroma

# ============================================================================
# Algorithm Configuration
# ============================================================================

# Select default scoring algorithm
# Options: simple_recency, composite_v1, chroma_rerank
ALGORITHM_PLUGIN=simple_recency

# Algorithm weights (only used by composite_v1)
# WEIGHT_RECENCY=0.2
# WEIGHT_COMPLETION=0.25
# WEIGHT_IMPORTANCE=0.30
# WEIGHT_FREQUENCY=0.15
# WEIGHT_RELEVANCE=0.10

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable structured JSON logging
LOG_FORMAT=json

# Log rotation settings
LOG_MAX_BYTES=10485760        # 10MB per file
LOG_BACKUP_COUNT=5            # Keep 5 backup files

# ============================================================================
# Performance Tuning (Advanced)
# ============================================================================

# Enable response caching (requires Redis - not implemented yet)
ENABLE_CACHE=false

# Cache TTL in seconds
CACHE_TTL=3600

# Maximum request size (in bytes)
MAX_REQUEST_SIZE=1048576      # 1MB limit

# Timeout for long-running operations (seconds)
OPERATION_TIMEOUT=30

# ============================================================================
# Development & Debugging
# ============================================================================

# Enable debug mode (more verbose logs)
DEBUG_MODE=false

# Enable CORS for browser clients
ENABLE_CORS=true

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# Notes
# ============================================================================

# How to use:
# 1. Copy this file to .env
# 2. Uncomment and modify values you need
# 3. Run: ./scripts/start.sh

# Priority order (highest to lowest):
# 1. Command line arguments
# 2. Environment variables (.env)
# 3. Built-in defaults

# Security tips for production:
# - Always enable CNAA_AUTH_ENABLED=true
# - Use a strong random API key (at least 32 characters)
# - Set appropriate CNAA_ALLOWED_AGENTS list
# - Consider using HTTPS reverse proxy
# - Regularly rotate API keys
# - Monitor access logs
