# Git Ignore Rules

## Python Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

## Virtual environments
venv/
ENV/
env/

## IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

## Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

## Environment Variables
.env
.env.local
.env.*.local
!.env.example
!.env.template

## Database Files
*.db
*.sqlite
*.db-shm
*.db-wal
cnaa_data.db
cnaa_memories.db
cnaa_states.db

## Log Files
*.log
logs/
cnaa.log

## Build Artifacts
*.tar.gz
*.zip
dist/
build/
*.whl

## Distribution Packages
dist_packages/

## Qoder Configuration
.qoder/__pycache__/
.qoder/cache/

## Platform-specific files
.DS_Store
Thumbs.db

## CI/CD and Workflow Files (if not tracked)
.github/workflows/*.yml.lock

## Development Tools
*.orig
*.bak
*.tmp
*.temp
.cache/

## Jupyter Notebooks
.ipynb_checkpoints/

## MyPy
.mypy_cache/
.dmypy.json
dmypy.json

## Ruff
.ruff_cache/

## Codecov
.coverage.*
coverage.xml
